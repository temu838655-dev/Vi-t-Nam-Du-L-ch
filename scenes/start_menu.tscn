[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]

[node name="StartMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.12, 0.2, 1)

[node name="CenterPanel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -250.0
offset_right = 330.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="CenterPanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="GameTitle" type="Label" parent="CenterPanel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "VIỆT NAM"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterPanel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "HÀNH TRÌNH BẤT TẬN"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="CenterPanel/Content"]
layout_mode = 2
text = "Khám phá • Trải nghiệm • Sống trọn Việt Nam"
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="CenterPanel/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 58)
text = "TIẾP TỤC"
theme_override_font_sizes/font_size = 24

[node name="StartButton" type="Button" parent="CenterPanel/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 58)
text = "BẮT ĐẦU"
theme_override_font_sizes/font_size = 24

[node name="GoogleButton" type="Button" parent="CenterPanel/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "ĐĂNG NHẬP GOOGLE"
theme_override_font_sizes/font_size = 18

[node name="StatusLabel" type="Label" parent="CenterPanel/Content"]
layout_mode = 2
autowrap_mode = 3
text = "Tiến trình được lưu trên thiết bị."
horizontal_alignment = 1

[connection signal="pressed" from="CenterPanel/Content/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="CenterPanel/Content/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="CenterPanel/Content/GoogleButton" to="." method="_on_google_pressed"]
